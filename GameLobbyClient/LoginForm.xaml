<Window x:Class="GameLobbyClient.LoginForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLobbyClient"
        mc:Ignorable="d"
        Title="LoginForm" Height="450" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None">
    <Grid>
        <Rectangle HorizontalAlignment="Center" Height="28" Stroke="Black" VerticalAlignment="Top" Width="400" Fill="Black" MouseLeftButtonDown="Rectangle_MouseLeftButtonDown"/>
        <Image x:Name="Exit" HorizontalAlignment="Right" Height="28" Margin="0,0,4,0" VerticalAlignment="Top" Width="31" Source="/[CITYPNG.COM]HD Red Square Close X Button Icon Transparent Background - 1000x1000.png" MouseLeftButtonDown="ExitButtonClick"/>
        <TextBox HorizontalAlignment="Left" Margin="107,281,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="255" Height="22" MaxLines="1"/>
        <TextBox HorizontalAlignment="Left" Margin="107,318,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="255" Height="22" MaxLines="1"/>
        <Rectangle HorizontalAlignment="Left" Height="422" Stroke="Black" VerticalAlignment="Top" Width="9" Fill="Black" MouseLeftButtonDown="Rectangle_MouseLeftButtonDown" Margin="0,28,0,0"/>
        <Rectangle HorizontalAlignment="Left" Height="422" Stroke="Black" VerticalAlignment="Top" Width="9" Fill="Black" MouseLeftButtonDown="Rectangle_MouseLeftButtonDown" Margin="391,28,0,0"/>
        <Rectangle HorizontalAlignment="Center" Height="10" Stroke="Black" VerticalAlignment="Top" Width="400" Fill="Black" MouseLeftButtonDown="Rectangle_MouseLeftButtonDown" Margin="0,441,0,0"/>
        <TextBlock HorizontalAlignment="Left" Margin="54,284,0,0" TextWrapping="Wrap" Text="User ID" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="43,321,0,0" TextWrapping="Wrap" Text="Password" VerticalAlignment="Top"/>
        <Button Content="로그인" HorizontalAlignment="Left" Margin="41,381,0,0" VerticalAlignment="Top" Height="28" Width="150"/>
        <Button Content="회원가입" HorizontalAlignment="Left" Margin="212,381,0,0" VerticalAlignment="Top" Height="28" Width="150"/>

    </Grid>
</Window>
